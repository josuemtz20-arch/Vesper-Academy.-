rules_version = '2';

/* ============================================================
 * Vesper Academy — Reglas de Firestore, base "(default)"
 * ------------------------------------------------------------
 * Publica ESTE archivo en: consola de Firebase → Firestore →
 * seleccionar la base "(default)" → pestaña Reglas → pegar → Publicar.
 * (La base "teachermanuals" tiene su propio archivo: firestore.rules.)
 *
 * En (default) solo vive placement_results: los LEADS del examen de
 * nivelación público (book_placement.html), que se crean SIN sesión
 * (solo con la apiKey pública del sitio).
 *
 * 🔒 PRIVACIDAD — lectura pública CERRADA:
 *     Estos docs llevan nombre, correo y teléfono de cada lead. Si la
 *     lectura fuera pública, cualquiera podría descargar tu lista de
 *     prospectos completa con un curl. Por eso: crear sí (es un
 *     formulario público), leer NO. Consecuencia aceptada: el botón
 *     "Ver historial" de book_placement.html solo mostrará el historial
 *     guardado en el dispositivo (el código ya degrada solo); la copia
 *     completa te sigue llegando por correo (FormSubmit) y puedes verla
 *     en la consola de Firebase cuando quieras.
 *
 * ⚠️ 2026-10-28: la base "(default)" NO EXISTE en el proyecto
 * vesper-academy (la API de Firestore responde 404 y no hay release de
 * reglas para ella). Por eso este archivo nunca ha estado publicado y los
 * leads de book_placement.html nunca se guardaron en Firestore (solo
 * llegaban por correo). Arreglo del 2026-10-28: la página ahora escribe en
 * "teachermanuals" (bloque placement_results de firestore.rules). Este
 * archivo queda SOLO como referencia; no hace falta crear la base ni
 * publicarlo.
 *
 * 2026-11-11: el create anónimo de abajo se CERRÓ también aquí. Los leads
 * ya no los escribe el navegador sino el Worker (ruta /lead), en
 * "teachermanuals". Si algún día se crea "(default)" y se publica este
 * archivo, que no vuelva a abrir una escritura sin sesión ni límite.
 *
 * Revisión 2026-10-28 (correo verificado): en esta base NO hay ninguna
 * regla con sesión — el único create es anónimo a propósito y todo lo
 * demás está cerrado —, así que el requisito email_verified que se
 * añadió a firestore.rules no aplica aquí. Sin cambios de reglas; no
 * hace falta volver a publicar este archivo.
 * ============================================================ */
service cloud.firestore {
  match /databases/{database}/documents {

    match /placement_results/{id} {
      // 2026-11-11: sin altas desde el navegador (las hace el Worker, /lead)
      allow create: if false;
      // los datos de contacto de tus leads NO son públicos
      allow read, update, delete: if false;
    }

    // cualquier otra colección de (default): cerrada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
